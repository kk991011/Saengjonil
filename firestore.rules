rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // 관리자: 본인 users 문서의 isAdmin == true (필드 없으면 false로 안전 처리).
    // 첫 관리자는 콘솔에서 수동으로 isAdmin=true 설정(규칙 우회) → 부트스트랩.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // users — 로그인 사용자는 모두 읽기(랭킹/멤버수 집계).
    //   본인 문서만 생성/수정, 단 isAdmin 자가 변경 금지(권한 상승 방지). 관리자는 전체 쓰기/삭제.
    //   (own 체크를 먼저 둬 일반 쓰기 시 isAdmin() get() 호출을 피함 — 읽기비용 절약)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.get('isAdmin', false) == false
                        && request.resource.data.get('groupIds', []).size() == 0)
                    || isAdmin();
      // 본인 문서 수정 가능하나 isAdmin·groupIds(조 배정)는 못 바꿈 → 조 배정은 관리자 전용
      allow update: if (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
                        && request.resource.data.get('groupIds', []) == resource.data.get('groupIds', []))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // groups — 모두 읽기. 쓰기(생성/수정/삭제)는 관리자만.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // records — 모두 읽기(랭킹/비교). 본인 기록(uid 일치)만 생성/수정/삭제. 관리자는 전체 삭제.
    match /records/{recId} {
      allow read: if isSignedIn();
      allow create, update: if (isSignedIn() && request.resource.data.uid == request.auth.uid)
                            || isAdmin();
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid)
                    || isAdmin();
    }

    // weekly_goals — 문서ID 접두(uid_...)가 본인 것일 때만 읽기/쓰기. 관리자는 전체 허용.
    match /weekly_goals/{goalId} {
      allow read, write: if (isSignedIn() && goalId.split('_')[0] == request.auth.uid)
                         || isAdmin();
    }

    // 생존 쿠폰 — 관리자는 전체 관리. 가입 회원은 본인 내역을 읽고 잔액만 감소시킬 수 있음.
    match /coupon_issues/{issueId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['remainingAmount', 'lastUsedAt'])
                        && request.resource.data.remainingAmount is int
                        && request.resource.data.remainingAmount >= 0
                        && request.resource.data.remainingAmount
                             < resource.data.get('remainingAmount', resource.data.amount)
                        && request.resource.data.lastUsedAt == request.time);
    }

    match /coupon_stats/{recipientId} {
      allow read: if isAdmin()
                  || (isSignedIn() && recipientId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 만료된 실제 쿠폰 문서를 삭제해도 발급 이력은 별도로 보존한다.
    match /coupon_history/{historyId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // 회원은 본인의 사용 내역만 생성·조회. 수정·삭제와 전체 조회는 관리자만 가능.
    match /coupon_usages/{usageId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.keys().hasOnly([
                             'recipientId', 'uid', 'recipientType', 'recipientName',
                             'amount', 'usageItem', 'note', 'allocations', 'usedAt', 'usedBy'
                           ])
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.recipientId == request.auth.uid
                        && request.resource.data.usedBy == request.auth.uid
                        && request.resource.data.recipientType == 'member'
                        && request.resource.data.amount is int
                        && request.resource.data.amount > 0
                        && request.resource.data.usageItem is string
                        && request.resource.data.usageItem.size() > 0
                        && request.resource.data.note is string
                        && request.resource.data.allocations is list
                        && request.resource.data.allocations.size() > 0
                        && request.resource.data.usedAt == request.time);
      allow update, delete: if isAdmin();
    }

    // 생존일지 미가입 쿠폰 수령인 — 일반 회원 목록/통계와 완전히 분리.
    match /coupon_recipients/{recipientId} {
      allow read, write: if isAdmin();
    }
  }
}
